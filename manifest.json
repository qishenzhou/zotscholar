{
  "manifest_version": 3,
  "name": "ZotScholar",
  "version": "1.5.1",
  "description": "Import your Zotero collections into Semantic Scholar, preserving folder structure.",

  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": ["cookies", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.semanticscholar.org/*",
    "https://api.semanticscholar.org/*",
    "https://api.zotero.org/*",
    "https://api.openalex.org/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [{
    "matches": ["https://www.semanticscholar.org/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],

  "action": {
    "default_popup": "popup.html",
    "default_title": "ZotScholar",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  }
}
